:ru_v2_0
varkill
urqw_game_lang="ru"
urqw_title="Это - тот дом, где Джэк жил"
pln <h1>#urqw_title$</h1>
image_caption="Классическая иллюстрированная обложка издания 1878 года"
image="cover.jpg|Джэк с семьёй на фоне дома"
pln Кумулятивная интерактивная литература
pln Разработка: Никита Цейковец
pln Иллюстрация: Рэндольф Кальдекотт 
pln Перевод с английского: Геннадий Аминов
next="Далее"
back="Назад"
check="Проверить"
insert_msg="Введите замену для "
last=12
words=14
зерно="*****"
крыс="****"
кот="***"
пёс="***"
коров="*****"
пса="***"
девиц="*****"
мужчин="******"
поп="***"
петух="*****"
крестьянин="**********"
цыплята="*******"
овечки="******"
бараны="******"
label=urqw_game_lang + "_v2_"
start_label=label + 1
btn #start_label$, #next$
end

:ru_v2_1
number=1
pln Это - тот дом, где Джэк жил.
proc buttons
end

:ru_v2_2
number=2
pln Это - [[#зерно$|insert_var="зерно" & goto insert]], что лежало давно
pln В доме, где Джэк жил.
proc buttons
end

:ru_v2_3
number=3
pln Это - та [[#крыс$|insert_var="крыс" & goto insert]]а, что ела [[#зерно$|insert_var="зерно" & goto insert]],
pln Что лежало давно
pln В доме, где Джэк жил.
proc buttons
end

:ru_v2_4
number=4
