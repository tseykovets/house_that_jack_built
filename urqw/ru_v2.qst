:ru_v2__check
correct=0
if StringLocaleLower(зерно) = "зерно" then correct += 1
if StringLocaleLower(крыс) = "крыс" then correct += 1
if StringLocaleLower(кот) = "кот" then correct += 1
if StringLocaleLower(пёс) = "пёс" or StringLocaleLower(пёс) = "пес" then correct += 1
if StringLocaleLower(коров) = "коров" then correct += 1
if StringLocaleLower(пса) = "пса" then correct += 1
if StringLocaleLower(девиц) = "девиц" then correct += 1
if StringLocaleLower(мужчин) = "мужчин" then correct += 1
if StringLocaleLower(поп) = "поп" then correct += 1
if StringLocaleLower(петух) = "петух" then correct += 1
if StringLocaleLower(крестьянин) = "крестьянин" then correct += 1
if StringLocaleLower(цыплята) = "цыплята" or StringLocaleLower(цыплята) = "цыплятки" then correct += 1
if StringLocaleLower(овечки) = "овечки" or StringLocaleLower(овечки) = "овцы" then correct += 1
if StringLocaleLower(бараны) = "бараны" or StringLocaleLower(бараны) = "барашки" then correct += 1
if correct = words then pln Всё верно. Это победа! & quit
if correct = 0 then pln У вас 0 правильных вариантов. Это провал!
if correct > 0 then pln У вас #PercentageRatio(correct, words)$% правильных вариантов. Надо ещё поработать!
current_label=label + number
btn #current_label$, Продолжить
end
